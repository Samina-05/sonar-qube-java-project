pipeline {
    agent any

    tools {
        maven 'M3'
    }

    environment {
        // Replace these values with the exact project key and organization shown in SonarQube Cloud.
        SONAR_PROJECT_KEY = 'Samina-05_sonar-qube-java-project'
        SONAR_ORGANIZATION = 'samina-05'
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm
            }
        }

        stage('2. Build and Test') {
            steps {
                sh 'mvn clean verify'
            }
        }

        stage('3. SonarCloud Scanning') {
            steps {
                withSonarQubeEnv('SonarCloud') { 
                    sh '''
                       mvn verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar
                       -Dsonar.projectKey=Samina-05_sonar-qube-java-project
                       -Dsonar.organization=$SONAR_ORGANIZATION
                       -Dsonar.host.url=https://sonarcloud.io
                    '''
                }
            }
        }

        stage('4. Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('5. Publish Artifact') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Review Console Output for details.'
        }
        always {
            junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'target/site/jacoco/**', allowEmptyArchive: true
        }
    }
}
