
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'M3'
    }

    environment {
        SONAR_PROJECT_KEY = 'Samina-05_sonar-qube-java-project'
        SONAR_ORGANIZATION = 'samina-05'
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm
            }
        }

        stage('2. Build and Test') {
            steps {
                dir('java-maven-sonarcloud-project') {
                    sh 'mvn clean verify'
                }
            }
        }

        stage('3. SonarCloud Scanning') {
            steps {
                dir('java-maven-sonarcloud-project') {
                    withSonarQubeEnv('SonarCloud') {
                        sh '''
                            mvn sonar:sonar \
                              -Dsonar.projectKey=$SONAR_PROJECT_KEY \
                              -Dsonar.organization=$SONAR_ORGANIZATION \
                              -Dsonar.host.url=https://sonarcloud.io
                        '''
                    }
                }
            }
        }

        stage('4. Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('5. Publish Artifact') {
            steps {
                archiveArtifacts(
                    artifacts: 'java-maven-sonarcloud-project/target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Review Console Output.'
        }

        always {
            junit(
                testResults: 'java-maven-sonarcloud-project/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )

            archiveArtifacts(
                artifacts: 'java-maven-sonarcloud-project/target/site/jacoco/**',
                allowEmptyArchive: true
            )
        }
    }
}
